# Copy this to deploy/.env on the VPS and fill it in, then run deploy/vps-docker.sh.
# Generate each secret with:  openssl rand -hex 32

# The domain/subdomain Traefik will route to this app (no https://)
DOMAIN=app.yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Discovered from your running Traefik (deploy/vps-docker.sh prints these)
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
CERT_RESOLVER=

# App database (its own Postgres container — separate from n8n)
DB_PASSWORD=

# App secrets — never change CODE_HASH_SALT after codes are issued
CODE_HASH_SALT=
CODE_ENCRYPTION_KEY=
AUTH_SECRET=
CRON_SECRET=

# ------------------------------------------------------------------
# Backend bot (docker-compose.bot.yml) — all optional; the container runs
# without them (admin API stays locked until BOT_ADMIN_TOKEN is set).
# ------------------------------------------------------------------
# Shared token the frontend sends to the bot's /api/admin/* (openssl rand -hex 32)
BOT_ADMIN_TOKEN=
# LLM (Groq free tier or OpenAI) — needed for the bot to actually reply
BOT_OPENAI_API_KEY=
BOT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
BOT_MODEL_NAME=llama-3.3-70b-versatile
BOT_MODEL_PROVIDER=groq
# WhatsApp via Evolution API — needed to send/receive real messages
BOT_EVOLUTION_API_URL=
BOT_EVOLUTION_API_KEY=
BOT_EVOLUTION_INSTANCE=
BOT_WEBHOOK_SECRET=
