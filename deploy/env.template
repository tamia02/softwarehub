# Copy this to deploy/.env on the VPS and fill it in, then run deploy/vps-docker.sh.
# Generate each secret with:  openssl rand -hex 32

# The domain/subdomain Traefik will route to this app (no https://)
DOMAIN=app.yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Discovered from your running Traefik (deploy/vps-docker.sh prints these)
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
CERT_RESOLVER=

# App database (its own Postgres container — separate from n8n)
DB_PASSWORD=

# App secrets — never change CODE_HASH_SALT after codes are issued
CODE_HASH_SALT=
CODE_ENCRYPTION_KEY=
AUTH_SECRET=
CRON_SECRET=
